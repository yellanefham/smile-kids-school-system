rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // الإدارة: حسابات محددة بالاسم فقط (التسجيل الذاتي مقفول)
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'admin@smilekids.school',
        'nabila.fakhry@gmail.com'
      ];
    }

    function isTeacher() {
      return isSignedIn() && request.auth.token.email in [
        'asmaa@smilekids.school','yara@smilekids.school','nabila@smilekids.school',
        'hend@smilekids.school','samar@smilekids.school','amira@smilekids.school',
        'ola@smilekids.school','marwa@smilekids.school','kariman@smilekids.school',
        'abeer@smilekids.school','basma@smilekids.school','nancy@smilekids.school'
      ];
    }

    function isStaff() { return isAdmin() || isTeacher(); }

    match /students/{id}   { allow read, update: if isStaff(); allow create, delete: if isAdmin(); }
    match /attendance/{id} { allow read, create, update: if isStaff(); allow delete: if isAdmin(); }
    match /grades/{id}     { allow read, create, update: if isStaff(); allow delete: if isAdmin(); }
    match /timetables/{id} { allow read: if isStaff(); allow write: if isAdmin(); }
    match /teachers/{id}   { allow read: if isStaff(); allow write: if isAdmin(); }
    match /settings/{id}   { allow read, write: if isStaff(); }

    // عرض محدود لولي الأمر: مستند واحد فقط، معرفه مشتق من (كود الطالب + الرقم السري)
    // لا يوجد سرد للمستندات للعامة، ولا أرقام هواتف ولا أرقام سرية داخل المستند
    match /public_view/{id} {
      allow get: if true;
      allow list, create, delete: if isStaff();
      allow update: if isStaff() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nameAr', 'nameEn', 'photo', 'parentUpdated', 'parentUpdatedAt'])
        && request.resource.data.parentUpdated == true
        && request.resource.data.nameAr is string && request.resource.data.nameAr.size() < 120
        && request.resource.data.nameEn is string && request.resource.data.nameEn.size() < 120
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() < 200000))
      );
    }

    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
